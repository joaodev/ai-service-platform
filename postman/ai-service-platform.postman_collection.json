    {
      "name": "AI",
      "description": "Authenticated AI endpoints for RAG, agent execution, and autonomous action observability.",
      "item": [
        {
          "name": "Ask AI",
          "request": {
            "description": "Run a retrieval-augmented AI query. Requires Authorization: Bearer {{accessToken}}.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Summarize open operational issues for customer {{customerId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ai",
                "ask"
              ]
            }
          }
        },
        {
          "name": "Run AI Agent",
          "request": {
            "description": "Queue an AI agent execution task. Requires Authorization: Bearer {{accessToken}}. The returned task id is stored in taskId.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Create an operational summary for today\",\n  \"session_id\": \"postman-session\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/agent",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ai",
                "agent"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var data = pm.response.json();",
                  "  if (data.task_id) pm.collectionVariables.set('taskId', data.task_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Agent Actions",
          "request": {
            "description": "List persisted autonomous agent actions. Supports limit, agent_name, and event_type query filters.",
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ai/agent-actions?limit=20&agent_name=TicketAgent&event_type=TICKET_CREATED",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ai",
                "agent-actions"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "agent_name",
                  "value": "TicketAgent"
                },
                {
                  "key": "event_type",
                  "value": "TICKET_CREATED"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "description": "Webhook configuration endpoints used by the event-driven integration layer.",
      "item": [
        {
          "name": "List Webhooks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/webhooks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks"
              ]
            }
          }
        },
        {
          "name": "Create Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"TICKET_CREATED\",\n  \"target_url\": \"https://example.com/webhooks/tickets\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhooks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var data = pm.response.json();",
                  "  if (data.id) pm.collectionVariables.set('webhookId', data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Webhook Active",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhooks/{{webhookId}}/active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "{{webhookId}}",
                "active"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "description": "Background task status lookup. Useful after running the AI agent endpoint.",
      "item": [
        {
          "name": "Get Task Status",
          "request": {
            "description": "Fetch the latest status and result payload for a background task id.",
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "{{taskId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}